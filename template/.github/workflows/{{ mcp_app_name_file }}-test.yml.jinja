---
name: Test {{ mcp_app_name }}

on:
  push:
    branches: ["main"]
    paths:
      - '{{ mcp_app_name }}/**.py'
      - '{{ mcp_app_name }}/pyproject.toml'
      - '{{ mcp_app_name }}/uv.lock'

  pull_request:
    branches: ["main"]
    paths:
      - '{{ mcp_app_name }}/**.py'
      - '{{ mcp_app_name }}/pyproject.toml'
      - '{{ mcp_app_name }}/uv.lock'

permissions:
  contents: write

jobs:
  tests:
    name: "DataRobot MCP: {{ mcp_app_name }} {% raw %}${{ matrix.python-version }}{% endraw %}"
    runs-on: "ubuntu-latest"
    defaults:
      run:
        working-directory: {{ mcp_app_name }}

    strategy:
      matrix:
        python-version: ["3.11", "3.12", "3.13"]

    steps:
      - uses: "actions/checkout@v6"
        with:
          ref: {% raw %}${{ github.head_ref || github.ref }}{% endraw %}

      # Ref: https://docs.astral.sh/uv/guides/integration/github/#installation
      - name: Setup uv
        uses: astral-sh/setup-uv@v7
        with:
          working-directory: {{ mcp_app_name }}
          enable-cache: true
          cache-dependency-glob: "uv.lock"
          python-version: {% raw %}${{ matrix.python-version }}{% endraw %}

      - name: Install Taskfile
        uses: arduino/setup-task@v2
        with:
          version: 3.x
          repo-token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      # Runs before `task install` on purpose: `uv sync` silently rewrites a
      # stale uv.lock, which would hide the very drift this step exists to catch.
      - name: Check uv.lock is up to date
        id: lock_check
        working-directory: {{ mcp_app_name }}
        continue-on-error: true
        run: |
          echo "Checking uv.lock matches pyproject.toml. If this fails, run 'task lock' and commit the result."
          task lock-check

      - name: Regenerate stale uv.lock and push to PR
        if: {% raw %}steps.lock_check.outcome == 'failure' && github.event_name == 'pull_request' && matrix.python-version == '3.11'{% endraw %}
        working-directory: {{ mcp_app_name }}
        run: |
          task lock
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add uv.lock
          git commit -m "chore: regenerate uv.lock"
          git push origin HEAD:{% raw %}${{ github.head_ref }}{% endraw %}

      - name: Fail if uv.lock was stale
        if: {% raw %}steps.lock_check.outcome == 'failure'{% endraw %}
        run: |
          echo "::error::{{ mcp_app_name }}/uv.lock is out of date with pyproject.toml."
          exit 1

      - name: Install Dependencies
        working-directory: {{ mcp_app_name }}
        run: task install

      - name: Run Static Checks
        working-directory: {{ mcp_app_name }}
        run: task lint-check

      - name: Run Unit Tests
        working-directory: {{ mcp_app_name }}
        run: task unit

      - name: Get Cover
        uses: orgoro/coverage@v3.2
        with:
          coverageFile: {{ mcp_app_name }}/coverage.xml
          token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
