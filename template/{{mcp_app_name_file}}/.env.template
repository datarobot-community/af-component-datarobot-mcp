# Refer to https://docs.datarobot.com/en/docs/api/api-quickstart/index.html#create-a-datarobot-api-key
# and https://docs.datarobot.com/en/docs/api/api-quickstart/index.html#retrieve-the-api-endpoint
# Can be deleted on a DataRobot codespace
DATAROBOT_API_TOKEN=
DATAROBOT_ENDPOINT=

# Required, unless logged in to pulumi cloud. Choose your own alphanumeric passphrase to be used for encrypting pulumi config
PULUMI_CONFIG_PASSPHRASE=

# If empty, a new use case will be created
DATAROBOT_DEFAULT_USE_CASE=

# ===============================================================================
#                              🚢 Deployment Config
# ===============================================================================

# Please create a separate stack per environment e.g. mcp-prod, mcp-eu
# See: https://www.pulumi.com/docs/iac/concepts/stacks/
# cd ./infra
# pulumi stack init # create an informative name for your new stack, set the passphrase to be the same as in your .env file
# pulimi stack select # select newly created stack
# cd ..
# task deploy # deploy a new model under the new stack

# Optional, defaults to true
# For older environments that don't support MCP, set USE_MCP_TARGET_TYPE=false
USE_MCP_TARGET_TYPE=true

# ===============================================================================
#                    ⚙️ MCP Server Hosting (MCP_DEPLOYMENT_TYPE)
# ===============================================================================
# How the MCP server is hosted:
#   datarobot-serverless (default) — Custom Model + Deployment
#   datarobot-workload-preview     — Workload API (Files catalog + image build)
# MCP_DEPLOYMENT_TYPE=datarobot-serverless

# --- Workload options (only used when MCP_DEPLOYMENT_TYPE=datarobot-workload-preview) --------
# Deploy a prebuilt image instead of building from source:
# MCP_WORKLOAD_IMAGE_URI=
# Catalog-relative Dockerfile path for source builds. Defaults to docker/Dockerfile
# when that file exists; set to "none" to force a generated-Dockerfile build:
# MCP_WORKLOAD_DOCKERFILE_PATH=docker/Dockerfile
# Container entrypoint as a JSON list or comma-separated values. Source builds
# default to python -m app.main; for MCP_WORKLOAD_IMAGE_URI the image's own
# entrypoint is used unless this is set:
# MCP_WORKLOAD_ENTRYPOINT=["python","-m","app.main"]
# MCP_WORKLOAD_CONTAINER_PORT=8080
# Max seconds to wait for the image build:
# MCP_WORKLOAD_BUILD_TIMEOUT_S=6000
# Workload priority: critical, high, moderate, or low:
# MCP_WORKLOAD_IMPORTANCE=high
# MCP_WORKLOAD_REPLICA_COUNT=1
# MCP_WORKLOAD_CPU=1
# Container memory in bytes (default 512 MiB):
# MCP_WORKLOAD_MEMORY=536870912

# --- MCP OAuth metadata (serverless and workload) ------------------------------
# OAuth protected-resource metadata is configured in oauth-config.yaml (copy
# oauth-config.yaml.template to start). Both settings below are optional
# overrides.
#
# Serve /.well-known/oauth-protected-resource without authentication. Overrides
# mcp_enable_unauthenticated_well_known_route in oauth-config.yaml; when neither
# is set it defaults to false. Agents fetch that route without a token, so XAA
# discovery requires it enabled:
# MCP_ENABLE_UNAUTHENTICATED_WELL_KNOWN_ROUTE=false
# Inline OAuth protected-resource metadata YAML (replaces oauth-config.yaml):
# MCP_OAUTH_METADATA=

# ===============================================================================
#           🛡️ DataRobot Instance with Private Certificate Authority
# ===============================================================================
# If DataRobot was setup with a private certificate authority, you have to set the
# the following variables when testing locally. (If unsure, you probably don't need
# them.)
# REQUESTS_CA_BUNDLE=/path/to/your/private_ca.crt
# SSL_CERT_FILE=/path/to/your/private_ca.crt
# CURL_CA_BUNDLE=/path/to/your/private_ca.crt
