[project]

name = "{{ mcp_app_name }}"
# Recipe release pipeline owns this version (not the component template).
# copier: skip
version = "0.0.0"
description = "DataRobot MCP Server"
requires-python = ">=3.11, <3.14"
dependencies = [
    "datarobot-genai[drmcp]>=0.29.50,<0.30.0",
]

[project.optional-dependencies]
dev = [
    "pytest-cov>=6.2.1",
    "pytest>=8.0.0",
    "ruff>=0.3.0",
    "mypy>=1.8.0",
    "pydantic>=2.6.3",
    "pytest-asyncio>=0.23.5",
    "pre-commit>=3.6.0",
    "types-requests>=2.31.0",
    "click>=8.3.0",
]
# Additional dependencies required to run the agent in DataRobot Agentic playground
agentic_playground = [
]

[build-system]
requires = ["hatchling>=1.18.0"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["app"]

# Identifies this template to the af-component CLI and to cve-sync, which pairs
# it with its policy/copier.yaml entry on `type`. cve-sync reads it before
# rendering, so keep it outside any jinja conditional.
[tool.af-component]
type = "mcp"

[tool.uv]
# Managed by cve-sync. Do not hand-edit between the markers: `cve-sync sync`
# rewrites everything inside them from policy. Keep notes above the begin marker.
# cve-sync:begin
# cve-sync:waived chromadb>1.5.9 NOT applied -- no-upstream-fix, expires 2026-12-09
constraint-dependencies = [
    "aiohttp>=3.14.3",
    "anyio>=4.14.2",
    "authlib>=1.7.1",
    "banks>=2.5.1",
    "bleach>=6.4.0",
    "click>=8.3.3",
    "crewai-tools>=1.15.21",
    "cryptography>=50.0.0",
    "datasets>=5.0.1",
    "fsspec>=2026.6.0",
    "gitpython>=3.1.62",
    "h2>=4.4.1",
    "hpack>=4.2.0",
    "hydra-core>=1.3.7",
    "idna>=3.15",
    "joserfc>=1.6.8",
    "json-repair>=0.60.1",
    "jupyter-server>=2.21.0",
    "jupyterlab>=4.6.4",
    "langchain>=1.3.9",
    "langchain-classic>=1.0.7",
    "langchain-core>=1.3.3",
    "langchain-nvidia-ai-endpoints>=1.4.2",
    "langchain-openai>=1.1.14",
    "langchain-text-splitters>=1.1.2",
    "langgraph-checkpoint>=4.1.1",
    "langgraph-sdk>=0.4.4",
    "langsmith>=0.8.18",
    "litellm>=1.96.2",
    "mako>=1.4.2",
    "mcp>=1.28.1",
    "mistune>=3.3.3",
    "mkdocs-material>=9.7.7",
    "multidict>=6.9.1",
    "nltk>=3.10.3",
    "notebook>=7.6.3",
    "oauthlib>=4.0.0",
    "openai>=2.30.0",
    "pdfminer.six>=20251230",
    "pillow>=12.3.0",
    "pip>=26.2",
    "pyarrow>=23.0.1",
    "pyasn1>=0.6.4",
    "pydantic-settings>=2.14.2",
    "pygments>=2.20.0",
    "PyJWT>=2.15.0",
    "pymdown-extensions>=11.0.1",
    "pymongo>=4.18.2",
    "pypdf>=6.19.0",
    "pytest>=9.0.3",
    "python-multipart>=0.0.31",
    "requests>=2.33.0",
    "sentence-transformers>=5.6.0",
    "setuptools>=83.0.0",
    "soupsieve>=2.9.0",
    "starlette>=1.3.1",
    "tornado>=6.5.9",
    "transformers>=5.10.0",
    "ujson>=5.13.0",
    "urllib3>=2.8.0",
    "uv>=0.12.18",
    "virtualenv>=21.7.13",
    "werkzeug>=3.1.9",
]
# cve-sync:end

[tool.ruff]
# Exclude a variety of commonly ignored directories.
exclude = [
  ".bzr",
  ".direnv",
  ".eggs",
  ".git",
  ".git-rewrite",
  ".hg",
  ".ipynb_checkpoints",
  ".mypy_cache",
  ".nox",
  ".pants.d",
  ".pyenv",
  ".pytest_cache",
  ".pytype",
  ".ruff_cache",
  ".svn",
  ".tox",
  ".venv",
  ".vscode",
  "__pypackages__",
  "_build",
  "buck-out",
  "build",
  "dist",
  "node_modules",
  "site-packages",
  "venv",
]

# Same as Black.
line-length = 88
indent-width = 4

target-version = "py312"

[tool.ruff.lint]
# Enable Pyflakes (`F`) and a subset of the pycodestyle (`E`)  codes by default.
# Unlike Flake8, Ruff doesn't enable pycodestyle warnings (`W`) or
# McCabe complexity (`C901`) by default.
select = ["E4", "E7", "E9", "F", "I"]
ignore = []

# Allow fix for all enabled rules (when `--fix`) is provided.
fixable = ["ALL"]
unfixable = []

# Allow unused variables when underscore-prefixed.
dummy-variable-rgx = "^(_+|(_+[a-zA-Z0-9_]*[a-zA-Z0-9]+?))$"

[tool.ruff.format]
# Like Black, use double quotes for strings.
quote-style = "double"

# Like Black, indent with spaces, rather than tabs.
indent-style = "space"

# Like Black, respect magic trailing commas.
skip-magic-trailing-comma = false

# Like Black, automatically detect the appropriate line ending.
line-ending = "auto"

# Enable auto-formatting of code examples in docstrings. Markdown,
# reStructuredText code/literal blocks and doctests are all supported.
#
# This is currently disabled by default, but it is planned for this
# to be opt-out in the future.
docstring-code-format = false

# Set the line length limit used when formatting code snippets in
# docstrings.
#
# This only has an effect when the `docstring-code-format` setting is
# enabled.
docstring-code-line-length = "dynamic"

[tool.mypy]
strict = true
python_version = "3.12"
plugins = "pydantic.mypy"
exclude = """(?x)(
    output/ # exclude files starting with "output"
    | deployment_.*/
    | include/   # or files starting with "include."
    | venv/
    | .venv/
    | .cache
    | e2e/
  )"""
check_untyped_defs = true
disallow_any_generics = true
disallow_incomplete_defs = true
disallow_subclassing_any = true
disallow_untyped_calls = true
disallow_untyped_decorators = true
disallow_untyped_defs = true
enable_error_code = "ignore-without-code"
implicit_reexport = true
ignore_missing_imports = true
no_implicit_optional = true
show_column_numbers = true
warn_redundant_casts = true
warn_return_any = true
warn_unused_configs = true
warn_unused_ignores = true
pretty = true
show_absolute_path = true

[[tool.mypy.overrides]]
module = "datarobot.*"
implicit_reexport = true
