from pathlib import Path
from unittest.mock import patch

import pulumi
import pytest

from infra.{{mcp_app_name_file}}_infra.mcp_bundle import (
    ensure_docker_dependency_files,
    get_docker_bundle_files,
    get_workload_source_files,
    merge_source_files,
)


def test_merge_source_files_keeps_last_duplicate_relative_path():
    merged = merge_source_files(
        [("/tmp/a", "requirements.txt"), ("/tmp/b", "app/main.py")],
        [("/tmp/c", "requirements.txt")],
    )

    assert merged == [("/tmp/b", "app/main.py"), ("/tmp/c", "requirements.txt")]


def test_get_workload_source_files_includes_docker_assets_when_using_provided_dockerfile(
    tmp_path: Path,
):
    deployments_path = tmp_path / "{{mcp_app_name_file}}"
    docker_dir = deployments_path / "docker"
    docker_dir.mkdir(parents=True)
    (docker_dir / "Dockerfile").write_text("FROM scratch\n", encoding="utf-8")
    (deployments_path / "pyproject.toml").write_text("", encoding="utf-8")
    (deployments_path / "uv.lock").write_text("", encoding="utf-8")

    core_files = [("/tmp/app/main.py", "app/main.py")]

    files = get_workload_source_files(
        deployments_path=deployments_path,
        dockerfile_relative_path="docker/Dockerfile",
        get_core_app_files=lambda: core_files,
    )

    rel_paths = {rel_path for _, rel_path in files}
    assert rel_paths == {"app/main.py", "docker/Dockerfile"}
    assert (docker_dir / "pyproject.toml").is_file()
    assert (docker_dir / "uv.lock").is_file()


def test_get_workload_source_files_bundles_a_custom_dockerfile_path(tmp_path: Path):
    """MCP_WORKLOAD_DOCKERFILE_PATH must reach the bundle, not just the artifact spec.

    The build looks for the Dockerfile at the catalog-relative path in the spec,
    so uploading `docker/Dockerfile` while the spec says `custom/Dockerfile`
    fails the build.
    """
    deployments_path = tmp_path / "{{mcp_app_name_file}}"
    (deployments_path / "custom").mkdir(parents=True)
    (deployments_path / "custom" / "Dockerfile").write_text(
        "FROM scratch\n", encoding="utf-8"
    )
    (deployments_path / "pyproject.toml").write_text("", encoding="utf-8")
    (deployments_path / "uv.lock").write_text("", encoding="utf-8")

    files = get_workload_source_files(
        deployments_path=deployments_path,
        dockerfile_relative_path="custom/Dockerfile",
        get_core_app_files=list,
    )

    rel_paths = {rel_path for _, rel_path in files}
    assert rel_paths == {"custom/Dockerfile"}


def test_get_docker_bundle_files_error_names_the_configured_path(tmp_path: Path):
    deployments_path = tmp_path / "{{mcp_app_name_file}}"
    deployments_path.mkdir(parents=True)

    with (
        patch.object(pulumi, "error"),
        pytest.raises(RuntimeError, match="custom/Dockerfile"),
    ):
        get_docker_bundle_files(deployments_path, "custom/Dockerfile")


def test_get_workload_source_files_skips_docker_assets_for_generated_mode(
    tmp_path: Path,
):
    core_files = [("/tmp/app/main.py", "app/main.py")]

    files = get_workload_source_files(
        deployments_path=tmp_path,
        dockerfile_relative_path=None,
        get_core_app_files=lambda: core_files,
    )

    assert files == core_files


def test_get_docker_bundle_files_requires_pyproject_and_lock(tmp_path: Path):
    deployments_path = tmp_path / "{{mcp_app_name_file}}"
    docker_dir = deployments_path / "docker"
    docker_dir.mkdir(parents=True)
    (docker_dir / "Dockerfile").write_text("FROM scratch\n", encoding="utf-8")

    with (
        patch.object(pulumi, "error") as mock_error,
        pytest.raises(RuntimeError, match="pyproject.toml"),
    ):
        get_docker_bundle_files(deployments_path)

    mock_error.assert_called_once()


def test_ensure_docker_dependency_files_copies_when_missing(tmp_path: Path):
    deployments_path = tmp_path / "{{mcp_app_name_file}}"
    deployments_path.mkdir(parents=True)
    (deployments_path / "pyproject.toml").write_text("new-content\n", encoding="utf-8")
    (deployments_path / "uv.lock").write_text("lock-content\n", encoding="utf-8")

    ensure_docker_dependency_files(deployments_path)

    docker_dir = deployments_path / "docker"
    assert (docker_dir / "pyproject.toml").read_text(
        encoding="utf-8"
    ) == "new-content\n"
    assert (docker_dir / "uv.lock").read_text(encoding="utf-8") == "lock-content\n"


def test_ensure_docker_dependency_files_overwrites_when_content_changes(tmp_path: Path):
    deployments_path = tmp_path / "{{mcp_app_name_file}}"
    docker_dir = deployments_path / "docker"
    docker_dir.mkdir(parents=True)
    (deployments_path / "pyproject.toml").write_text("new-content\n", encoding="utf-8")
    (deployments_path / "uv.lock").write_text("lock-content\n", encoding="utf-8")
    (docker_dir / "pyproject.toml").write_text("old-content\n", encoding="utf-8")
    (docker_dir / "uv.lock").write_text("old-lock\n", encoding="utf-8")

    ensure_docker_dependency_files(deployments_path)

    assert (docker_dir / "pyproject.toml").read_text(
        encoding="utf-8"
    ) == "new-content\n"
    assert (docker_dir / "uv.lock").read_text(encoding="utf-8") == "lock-content\n"


def test_ensure_docker_dependency_files_skips_write_when_unchanged(tmp_path: Path):
    deployments_path = tmp_path / "{{mcp_app_name_file}}"
    docker_dir = deployments_path / "docker"
    docker_dir.mkdir(parents=True)
    (deployments_path / "pyproject.toml").write_text("same-content\n", encoding="utf-8")
    (deployments_path / "uv.lock").write_text("same-lock\n", encoding="utf-8")
    (docker_dir / "pyproject.toml").write_text("same-content\n", encoding="utf-8")
    (docker_dir / "uv.lock").write_text("same-lock\n", encoding="utf-8")
    mtime_before = (docker_dir / "pyproject.toml").stat().st_mtime_ns

    ensure_docker_dependency_files(deployments_path)

    assert (docker_dir / "pyproject.toml").stat().st_mtime_ns == mtime_before
