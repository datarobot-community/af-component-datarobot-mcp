import asyncio
import glob
import importlib
import logging
import os

from mcp.server.fastmcp import FastMCP
from starlette.responses import JSONResponse

from app.recipe.core.recipe_config import get_recipe_config
from app.recipe.core.recipe_credentials import get_recipe_credentials

from .config import get_config
from .credentials import get_credentials
from .logging import MCPLogging
from .telemetry import initialize_telemetry


def _import_modules_from_dir(directory: str, package_prefix: str) -> None:
    """Dynamically import all modules from a directory."""
    for file in glob.glob(os.path.join(directory, "*.py")):
        if os.path.basename(file) != "__init__.py":
            module_name = (
                f"{package_prefix}.{os.path.splitext(os.path.basename(file))[0]}"
            )
            importlib.import_module(module_name)


# Dynamically import all modules from tools and prompts to register them with MCP
app_dir = os.path.dirname(os.path.dirname(os.path.dirname(__file__)))
{% if mcp_template_framework == "base_with_tools" %}
_import_modules_from_dir(os.path.join(app_dir, "base", "tools"), "app.base.tools")
_import_modules_from_dir(os.path.join(app_dir, "base", "prompts"), "app.base.prompts")
_import_modules_from_dir(
    os.path.join(app_dir, "base", "resources"), "app.base.resources"
)
{% endif %}
_import_modules_from_dir(os.path.join(app_dir, "recipe", "tools"), "app.recipe.tools")
_import_modules_from_dir(
    os.path.join(app_dir, "recipe", "prompts"), "app.recipe.prompts"
)
_import_modules_from_dir(
    os.path.join(app_dir, "recipe", "resources"), "app.recipe.resources"
)


class DataRobotMCPServer:
    """
    DataRobot MCP server implementation using FastMCP framework.
    """

    def __init__(self, mcp: FastMCP, transport: str = "streamable-http"):
        """Initialize the server."""
        self._config = get_config()
        MCPLogging(self._config.app_log_level)
        self._logger = logging.getLogger(self.__class__.__name__)
        self._logger.info(f"Config initialized: {self._config}")
        self._credentials = get_credentials()
        self._logger.info("Credentials initialized")
        self._recipe_config = get_recipe_config()
        self._logger.info(f"Recipe config initialized: {self._recipe_config}")
        self._recipe_credentials = get_recipe_credentials()
        self._logger.info("Recipe credentials initialized")
        self._mcp = mcp
        self._mcp_transport = transport
        self._root_tracing_span = initialize_telemetry()

        if transport == "streamable-http":
            # Custom apps checks this route to see if the server is running
            @self._mcp.custom_route("/", methods=["GET"])
            async def handle_health(_):
                return JSONResponse(
                    status_code=200,
                    content={
                        "status": "healthy",
                        "message": "DataRobot MCP Server is running",
                    },
                )

            {%- if enable_tag_support %}
            # Custom endpoint to get all tags
            @self._mcp.custom_route("/tags", methods=["GET"])
            async def handle_tags(_):
                try:
                    tags = await self._mcp.get_all_tags()
                    return JSONResponse(
                        status_code=200,
                        content={
                            "tags": tags,
                            "count": len(tags),
                            "message": "All available tags retrieved successfully",
                        },
                    )
                except Exception as e:
                    return JSONResponse(
                        status_code=500,
                        content={
                            "error": f"Failed to retrieve tags: {str(e)}",
                        },
                    )
            {%- endif %}

    def run(self) -> None:
        """Run the DataRobot MCP server synchronously."""
        try:
            # Validate configuration
            if not self._credentials.has_datarobot_credentials():
                self._logger.error("DataRobot credentials not configured")
                raise ValueError("Missing required DataRobot credentials")

            # List registered tools and prompts before starting server
            tools = asyncio.run(self._mcp.list_tools())
            prompts = asyncio.run(self._mcp.list_prompts())
            resources = asyncio.run(self._mcp.list_resources())

            self._logger.info(f"Registered tools: {len(tools)}")
            for tool in tools:
                self._logger.info(f" - {tool.name}")
            self._logger.info(f"Registered prompts: {len(prompts)}")
            for prompt in prompts:
                self._logger.info(f" - {prompt.name}")
            self._logger.info(f"Registered resources: {len(resources)}")
            for resource in resources:
                self._logger.info(f" - {resource.name}")

            # Start the server
            self._logger.info("Starting MCP server...")
            self._mcp.run(transport=self._mcp_transport)

        except Exception as e:
            self._logger.error(f"Server error: {e}")
            self._root_tracing_span.record_exception(e)
            raise
